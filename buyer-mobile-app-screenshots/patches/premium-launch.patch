+const paidOrder = {
+  channel: "wholesale",
+  orderNumber: 1043,
+  customerName: "Mina Farahani",
+  email: "mina@saffronkitchen.com",
+  city: "Dallas",
+  state: "TX",
+  items: [
+    { name: "Barbari — Case of 25", quantity: 2 },
+    { name: "Sesame — Case of 25", quantity: 1 },
+  ],
+  caseCount: 3,
+  boxCount: 3,
+  loafCount: 75,
+  subtotalCents: 17_000,
