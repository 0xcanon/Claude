+test("shipping is billed per case, not by dividing loaves into boxes", () => {
+  // Three cases is three boxes at $12.50 whatever the retail box size says.
+  // A loaf-based rule would have re-rated this to two boxes at unitsPerBox 50
+  // and one box at 100, quietly undercharging freight.
+  for (const unitsPerBox of [25, 50, 100]) {
+    const cart = priceCart([{ sku: "WS-BARBARI-25", cases: 3 }], { rateCents: 1250, unitsPerBox });
+    assert.ok(cart.ok);
+    if (!cart.ok) return;
+    assert.equal(cart.boxCount, 3);
+    assert.equal(cart.shippingCents, 3750);
+  }
+});
