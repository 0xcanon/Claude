-const SHOPIFY_API_VERSION = "2026-07";
-
-type WholesaleApplicationForShopify = {
-  id: string;
-  businessName: string;
-  contactName: string;
-  email: string;
-  street: string;
-  street2: string;
-  city: string;
-  state: string;
-  zip: string;
-};
-
-type ShopifyCompanyCreateData = {
-  companyCreate?: {
-    company?: {
-      id: string;
-      locations?: { edges?: Array<{ node?: { id?: string } }> };
-    } | null;
-    userErrors?: Array<{ message?: string }>;
-  };
-};
-
-type ShopifyCompanyLookupData = {
-  companies?: {
-    nodes?: Array<{
-      id?: string;
-      externalId?: string;
-      locations?: { nodes?: Array<{ id?: string }> };
-    }>;
-  };
-};
-
-function shopDomain() {
-  const raw = String(process.env.SHOPIFY_STORE_DOMAIN || "")
-    .trim()
-    .toLowerCase()
-    .replace(/^https?:\/\//, "")
-    .split("/")[0];
-  if (!/^[a-z0-9][a-z0-9-]*\.myshopify\.com$/.test(raw)) return null;
-  return raw;
-}
-
-function adminToken() {
-  const token = String(process.env.SHOPIFY_ADMIN_ACCESS_TOKEN || "").trim();
-  return token || null;
-}
-
-export function shopifyB2BConfigured() {
-  return Boolean(shopDomain() && adminToken());
-}
-
-export function shopifyBuyerPortalUrl() {
-  const configured = String(process.env.SHOPIFY_B2B_ACCOUNT_URL || "").trim();
-  if (configured) {
-    try {
-      const url = new URL(configured);
-      if (url.protocol === "https:") return url.toString();
-    } catch {
-      // Fall back to the hosted Shopify account page below.
-    }
-  }
-  return null;
-}
-
-function contactNames(fullName: string) {
-  const parts = fullName.trim().split(/\s+/).filter(Boolean);
-  const firstName = parts.shift() || "Wholesale";
