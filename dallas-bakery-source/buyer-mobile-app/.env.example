# The wholesale API and ordering backend. Everything the app needs — sign-in,
# catalog, pricing, payment, and order history — comes from here.
EXPO_PUBLIC_API_URL=https://dallasbakery.net

# Stripe publishable key (pk_live_… in production, pk_test_… for testing).
# Publishable keys are safe to ship; the secret key lives only on the server
# and must never appear in this file or in the app.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
